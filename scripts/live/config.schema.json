{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/devosurf/migmate-cli/scripts/live/config.schema.json",
  "title": "Maintainer-only optional live test configuration",
  "type": "object",
  "required": ["schemaVersion", "jobType", "jobConfig", "acknowledgement"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "jobType": {
      "enum": ["file_migration", "teams_archive"]
    },
    "acknowledgement": {
      "const": "I authorize disposable live test probes"
    },
    "jobConfig": {
      "type": "object",
      "description": "The same parsed operator configuration accepted by production. Credentials remain typed file references, never raw secrets.",
      "properties": {
        "route": {
          "enum": ["sharepoint_library_to_shared_drive", "shared_drive_to_sharepoint_library"],
          "description": "shared_drive_to_sharepoint_library runs the reverse probe instead of the SharePoint-source suite."
        },
        "rclone": {
          "type": "object",
          "required": ["config", "destinationRemote"],
          "properties": {
            "config": {
              "$ref": "#/$defs/fileReference"
            },
            "sourceRemote": {
              "type": "string",
              "minLength": 1
            },
            "destinationRemote": {
              "type": "string",
              "minLength": 1
            },
            "sharepointDestinationRemote": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "mappings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": ["id", "sourceDriveId", "sourceItemId", "destDriveId", "destFolderId"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "sourceDriveId": { "type": "string", "minLength": 1 },
                  "sourceItemId": { "type": "string", "minLength": 1 },
                  "destDriveId": { "type": "string", "minLength": 1 },
                  "destFolderId": { "type": "string", "minLength": 1 },
                  "sourceSiteId": { "type": "string", "minLength": 1 }
                },
                "not": { "required": ["sourceType"] }
              },
              {
                "type": "object",
                "description": "Google Shared Drive folder (stable ids) into a SharePoint library-relative folder path.",
                "required": [
                  "id",
                  "sourceType",
                  "sourceDriveId",
                  "sourceItemId",
                  "destDriveId",
                  "destFolderPath"
                ],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "sourceType": { "const": "google_shared_drive" },
                  "sourceDriveId": { "type": "string", "minLength": 1 },
                  "sourceItemId": { "type": "string", "minLength": 1 },
                  "destDriveId": { "type": "string", "minLength": 1 },
                  "destFolderPath": { "type": "string" }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "graph": {
          "type": "object",
          "required": ["tenantId", "clientId"],
          "properties": {
            "tenantId": {
              "type": "string",
              "format": "uuid"
            },
            "clientId": {
              "type": "string",
              "format": "uuid"
            }
          },
          "additionalProperties": false
        },
        "secrets": {
          "type": "object",
          "required": ["teams_graph_client_secret"],
          "properties": {
            "teams_graph_client_secret": {
              "$ref": "#/$defs/fileReference"
            },
            "google_service_account": {
              "$ref": "#/$defs/fileReference"
            }
          },
          "additionalProperties": false
        },
        "destination": {
          "type": "object",
          "required": ["destDriveId", "destFolderId"],
          "properties": {
            "destDriveId": { "type": "string", "minLength": 1 },
            "destFolderId": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": ["kind", "teamId", "channelId"],
                "properties": {
                  "kind": {
                    "const": "channel"
                  },
                  "teamId": {
                    "type": "string"
                  },
                  "channelId": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "object",
                "required": ["kind", "teamId"],
                "properties": {
                  "kind": {
                    "const": "team"
                  },
                  "teamId": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "object",
                "required": ["kind", "userId"],
                "properties": {
                  "kind": {
                    "const": "user-chats"
                  },
                  "userId": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        },
        "window": {
          "type": "object",
          "required": ["from", "to"],
          "properties": {
            "from": {
              "type": "string",
              "format": "date-time"
            },
            "to": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "cloud": {
          "const": "Global"
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "retainedHistory": {
          "type": "boolean"
        },
        "transcripts": {
          "type": "boolean"
        },
        "attachmentBytes": {
          "type": "boolean"
        }
      }
    },
    "fixtures": {
      "type": "object",
      "description": "File route: explicit disposable roots. A SharePoint-source run also needs a separate scoped source-write application; normal route credentials stay read-only on SharePoint. A reverse run writes its disposable Google source as the acting account and its SharePoint copy root with the destination app. Only tool-created IDs are mutated or deleted. Archive uses actual in-scope samples, not supplied captured outputs.",
      "properties": {
        "disposableRoots": {
          "type": "object",
          "required": ["sourceDriveId", "sourceItemId", "destDriveId", "acknowledged"],
          "properties": {
            "sourceDriveId": {
              "type": "string",
              "minLength": 1
            },
            "sourceItemId": {
              "type": "string",
              "minLength": 1
            },
            "destDriveId": {
              "type": "string",
              "minLength": 1
            },
            "destFolderId": {
              "type": "string",
              "minLength": 1
            },
            "destFolderPath": {
              "type": "string",
              "description": "Reverse runs: the existing SharePoint folder, relative to the library root, that receives the disposable copy root."
            },
            "acknowledged": {
              "const": true
            }
          }
        },
        "graphMutation": {
          "type": "object",
          "required": ["tenantId", "clientId", "clientSecret"],
          "properties": {
            "tenantId": {
              "type": "string",
              "format": "uuid"
            },
            "clientId": {
              "type": "string",
              "format": "uuid"
            },
            "clientSecret": {
              "$ref": "#/$defs/fileReference"
            }
          }
        },
        "specialSources": {
          "type": "object",
          "description": "Optional real direct-child SharePoint fixture identities for package/reference/undownloadable observations. A supplied sample must produce its omission live; a missing one is a gate unless the source refuses to create that kind or the scanned scope's kind census shows none, per ADR-0006. Never fabricated source entries.",
          "properties": {
            "packageId": {
              "type": "string",
              "minLength": 1
            },
            "referenceId": {
              "type": "string",
              "minLength": 1
            },
            "undownloadableId": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "$defs": {
    "fileReference": {
      "type": "object",
      "required": ["resolver", "path"],
      "properties": {
        "resolver": {
          "const": "file"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "const": "0600"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "jobType": {
            "const": "file_migration"
          }
        }
      },
      "then": {
        "required": ["fixtures"],
        "properties": {
          "jobConfig": {
            "required": ["rclone", "mappings"]
          },
          "fixtures": {
            "required": ["disposableRoots"]
          }
        },
        "if": {
          "properties": {
            "jobConfig": {
              "required": ["route"],
              "properties": { "route": { "const": "shared_drive_to_sharepoint_library" } }
            }
          }
        },
        "then": {
          "properties": {
            "jobConfig": {
              "properties": { "rclone": { "required": ["sharepointDestinationRemote"] } }
            },
            "fixtures": {
              "properties": { "disposableRoots": { "required": ["destFolderPath"] } }
            }
          }
        },
        "else": {
          "properties": {
            "jobConfig": {
              "properties": { "rclone": { "required": ["sourceRemote"] } }
            },
            "fixtures": {
              "required": ["graphMutation"],
              "properties": { "disposableRoots": { "required": ["destFolderId"] } }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "jobType": {
            "const": "teams_archive"
          }
        }
      },
      "then": {
        "properties": {
          "jobConfig": {
            "required": ["graph", "secrets", "scopes", "window", "cloud", "timezone"],
            "allOf": [
              {
                "if": { "required": ["destination"] },
                "then": {
                  "properties": {
                    "secrets": { "required": ["google_service_account"] }
                  }
                }
              }
            ]
          }
        }
      }
    }
  ],
  "description": "Run npm run test:live -- --config <this JSON file>. Optional: needs Node 24.15.0 or later, the exact managed v1.75.0 host binary, live Global tenant consent/licensing/options and Google Shared Drive access as appropriate. Every probe performs real operations against disposable roots; nothing is written into the repository."
}
