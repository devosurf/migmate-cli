{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/devosurf/migmate-cli/qualification/probe-config.schema.json",
  "title": "Maintainer-only live exact-route probe configuration",
  "type": "object",
  "required": ["schemaVersion", "jobType", "jobConfig", "acknowledgement"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "jobType": {
      "enum": ["file_migration", "teams_archive"]
    },
    "acknowledgement": {
      "const": "I authorize disposable live qualification probes"
    },
    "jobConfig": {
      "type": "object",
      "description": "The same parsed operator configuration accepted by production. No qualified bundle is required to establish the first route proof. Credentials remain typed file references, never raw secrets.",
      "properties": {
        "guarantees": {
          "type": "string",
          "minLength": 1,
          "default": "default"
        },
        "rclone": {
          "type": "object",
          "required": ["config", "sourceRemote", "destinationRemote"],
          "properties": {
            "config": {
              "$ref": "#/$defs/fileReference"
            },
            "sourceRemote": {
              "type": "string",
              "minLength": 1
            },
            "destinationRemote": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "mappings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "sourceDriveId", "sourceItemId", "destDriveId", "destFolderId"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "sourceDriveId": {
                "type": "string",
                "minLength": 1
              },
              "sourceItemId": {
                "type": "string",
                "minLength": 1
              },
              "destDriveId": {
                "type": "string",
                "minLength": 1
              },
              "destFolderId": {
                "type": "string",
                "minLength": 1
              },
              "sourceSiteId": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "graph": {
          "type": "object",
          "required": ["tenantId", "clientId"],
          "properties": {
            "tenantId": {
              "type": "string",
              "format": "uuid"
            },
            "clientId": {
              "type": "string",
              "format": "uuid"
            }
          },
          "additionalProperties": false
        },
        "secrets": {
          "type": "object",
          "required": ["teams_graph_client_secret"],
          "properties": {
            "teams_graph_client_secret": {
              "$ref": "#/$defs/fileReference"
            },
            "google_service_account": {
              "$ref": "#/$defs/fileReference"
            }
          },
          "additionalProperties": false
        },
        "destination": {
          "type": "object",
          "required": ["destDriveId", "destFolderId"],
          "properties": {
            "destDriveId": { "type": "string", "minLength": 1 },
            "destFolderId": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": ["kind", "teamId", "channelId"],
                "properties": {
                  "kind": {
                    "const": "channel"
                  },
                  "teamId": {
                    "type": "string"
                  },
                  "channelId": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "object",
                "required": ["kind", "teamId"],
                "properties": {
                  "kind": {
                    "const": "team"
                  },
                  "teamId": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "object",
                "required": ["kind", "userId"],
                "properties": {
                  "kind": {
                    "const": "user-chats"
                  },
                  "userId": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        },
        "window": {
          "type": "object",
          "required": ["from", "to"],
          "properties": {
            "from": {
              "type": "string",
              "format": "date-time"
            },
            "to": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "cloud": {
          "const": "Global"
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "retainedHistory": {
          "type": "boolean"
        },
        "transcripts": {
          "type": "boolean"
        },
        "attachmentBytes": {
          "type": "boolean"
        }
      }
    },
    "fixtures": {
      "type": "object",
      "description": "File route: explicit disposable roots and a separate scoped source-write application. Normal route credentials stay read-only on SharePoint. Only tool-created IDs are mutated or deleted. Archive uses actual in-scope samples, not supplied captured outputs.",
      "properties": {
        "disposableRoots": {
          "type": "object",
          "required": [
            "sourceDriveId",
            "sourceItemId",
            "destDriveId",
            "destFolderId",
            "acknowledged"
          ],
          "properties": {
            "sourceDriveId": {
              "type": "string",
              "minLength": 1
            },
            "sourceItemId": {
              "type": "string",
              "minLength": 1
            },
            "destDriveId": {
              "type": "string",
              "minLength": 1
            },
            "destFolderId": {
              "type": "string",
              "minLength": 1
            },
            "acknowledged": {
              "const": true
            }
          }
        },
        "graphMutation": {
          "type": "object",
          "required": ["tenantId", "clientId", "clientSecret"],
          "properties": {
            "tenantId": {
              "type": "string",
              "format": "uuid"
            },
            "clientId": {
              "type": "string",
              "format": "uuid"
            },
            "clientSecret": {
              "$ref": "#/$defs/fileReference"
            }
          }
        },
        "specialSources": {
          "type": "object",
          "description": "Optional real direct-child SharePoint fixture identities for actual package/reference/undownloadable/name-limit observations. A supplied sample must produce its omission live; a missing one is a gate unless the source refuses to create that kind or the scanned scope's kind census shows none, per ADR-0006. Never fabricated source entries.",
          "properties": {
            "packageId": {
              "type": "string",
              "minLength": 1
            },
            "referenceId": {
              "type": "string",
              "minLength": 1
            },
            "undownloadableId": {
              "type": "string",
              "minLength": 1
            },
            "pathUnrepresentableId": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "$defs": {
    "fileReference": {
      "type": "object",
      "required": ["resolver", "path"],
      "properties": {
        "resolver": {
          "const": "file"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "const": "0600"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "jobType": {
            "const": "file_migration"
          }
        }
      },
      "then": {
        "required": ["fixtures"],
        "properties": {
          "jobConfig": {
            "required": ["rclone", "mappings"]
          },
          "fixtures": {
            "required": ["disposableRoots", "graphMutation"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "jobType": {
            "const": "teams_archive"
          }
        }
      },
      "then": {
        "properties": {
          "jobConfig": {
            "required": ["graph", "secrets", "scopes", "window", "cloud", "timezone"],
            "allOf": [
              {
                "if": { "required": ["destination"] },
                "then": {
                  "properties": {
                    "secrets": { "required": ["google_service_account"] }
                  }
                }
              }
            ]
          }
        }
      }
    }
  ],
  "description": "Run node scripts/qualify-route.ts --config <this JSON file> --output <new directory>. Requires Node24, exact managed v1.75.0 host binary, real native desktop, live Global tenant consent/licensing/options and Google Shared Drive access as appropriate. All outputs are created by real operations; the tool has no captured-output import or claimed-success toggle."
}
